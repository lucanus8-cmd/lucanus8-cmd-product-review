# 이 파일을 secrets.toml 로 복사하고 값을 채우세요. (secrets.toml 은 절대 git/이미지에 올리지 마세요)
# 접속 비밀번호 — 이 값을 아는 사람만 앱에 들어올 수 있습니다.
APP_PASSWORD = "회사에서_정한_비밀번호"

# 1상 비용 어림 계산기의 단가 (원 단위). 실제 견적에서 나온 값이라 코드에는 적지 않는다.
# 비워 두면 화면의 '단가 고치기'에서 그때그때 직접 넣어 쓴다.
[phase1_cost]
cro_base = 0          # 임상 CRO 기본
cro_per_period = 0    # 임상 CRO · 1기당
cro_per_subject = 0   # 임상 CRO · 대상자 1명당
lab_base = 0          # 분석 기본
lab_per_sample = 0    # 분석 · 검체 1개당
site_24h = 0          # 병원 · 1명 1기당 (채혈 24시간 이하)
site_72h = 0          # 병원 · 1명 1기당 (채혈 72시간)
site_240h = 0         # 병원 · 1명 1기당 (채혈 240시간 이상)
